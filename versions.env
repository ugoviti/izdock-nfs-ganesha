# izdock/nfs-ganesha component versions and checksums (single source of truth).
#
# Read by build/compile.sh (inside the image build, via build/lib.sh load_versions),
# by the Gitea workflows (base image and tags) and by tools/make-updates.sh,
# which checks upstream and rewrites the values with --apply.
# Plain KEY=value lines only: no spaces, no quotes, no commands.
# Every *_SHA256 is the sha256 of the exact file that is downloaded.
# tools/make-updates.sh stays on the major version of each component: a new major is only reported.
# Pin: <NAME>_PIN=<version> next to a <NAME>_VER keeps that component on <version>
# (tools/make-updates.sh never moves it, and --apply sets it with its sha256).

## base image - https://hub.docker.com/_/debian
# the image is docker.io/library/debian:<SUITE>-slim@<DIGEST>: the digest pins the content,
# make-updates proposes a new digest when the upstream tag is rebuilt (OS security updates)
DEBIAN_SUITE=trixie
DEBIAN_DIGEST=sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

## nfs-ganesha - https://github.com/nfs-ganesha/nfs-ganesha/releases (archive of tag V<VER>)
# rolling release model since V8.0: every non-prerelease Vx.y is a stable release
GANESHA_VER=15.11
GANESHA_SHA256=4273e1c623f680f3cbfd096f282b71a483bc1db0a33781290a1c48b8ccb50c52

## ntirpc - https://github.com/nfs-ganesha/ntirpc (archive of tag v<VER>)
# the version of the src/libntirpc submodule of the nfs-ganesha tag (make-updates reads it)
NTIRPC_VER=15.11
NTIRPC_SHA256=60f1101e9241660e27da71342b8e2b8c07912b9c67b278bcce084adf363d19dc

## prometheus-cpp-lite - https://github.com/biaks/prometheus-cpp-lite (archive of a commit)
# the src/monitoring/prometheus-cpp-lite submodule of the ntirpc tag (make-updates reads it)
PROMETHEUS_CPP_LITE_COMMIT=48d09c45ee6deb90e02579b03037740e1c01fd27
PROMETHEUS_CPP_LITE_SHA256=f115ff5ba0194358a4784912b103521804db435f75a9cfa52bc4df3b1aa9e7b8
